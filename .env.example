# AnyRoller Driver App Environment Configuration
# Configure secrets in the AI Studio Secrets panel.
# Never commit actual secret values to version control.

# Live AnyTrader / AnyRoller Express API origin (defaults to production)
API_BASE_URL=https://www.anytrader.co.uk

# Google Maps SDK for Android API key (restrict by package com.anyroller.driver + SHA-1 in Google Cloud Console)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
