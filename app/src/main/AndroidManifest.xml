<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Wake Lock -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground Location for Live Driver Dispatch & Passenger Tracking -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ High-Priority Ride Offer & Chat Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Least-privilege package visibility for Navigation, WhatsApp, Browser & Phone -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="waze.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="wa.me" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Google Maps API Key injected via Secrets Gradle Plugin (.env / .env.example) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Default FCM notification channel for high-priority ride updates -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ride_chat_updates" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links for Stripe Custom Tab returns & WhatsApp Alert deep links -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.anytrader.co.uk" android:pathPrefix="/driver-terminal" />
                <data android:scheme="https" android:host="www.anytrader.co.uk" android:pathPrefix="/driver-dashboard" />
                <data android:scheme="https" android:host="www.anytrader.co.uk" android:pathPrefix="/driver-return" />
                <data android:scheme="https" android:host="www.anytrader.co.uk" android:pathPrefix="/platform-fee-success" />
                <data android:scheme="https" android:host="anytrader.co.uk" android:pathPrefix="/driver-terminal" />
                <data android:scheme="https" android:host="anytrader.co.uk" android:pathPrefix="/driver-return" />
                <data android:scheme="https" android:host="anytrader.co.uk" android:pathPrefix="/platform-fee-success" />
            </intent-filter>
        </activity>

        <!-- Persistent Background GPS & 60s Safety Heartbeat Foreground Service -->
        <service
            android:name=".service.DriverLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- High-Priority FCM Messaging Service (ride_offers_urgent & ride_chat_updates) -->
        <service
            android:name=".service.AnyRollerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Local Scheduled Ride Reminder BroadcastReceiver (45m & 15m before pickup) -->
        <receiver
            android:name=".service.ScheduledRideReminderReceiver"
            android:exported="false" />

        <!-- FileProvider for Gold Driver CSV Earnings & Expense Export -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
